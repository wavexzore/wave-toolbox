{
  // T-007 手动清单演示（设置；无害且可观察）
  id: "toolbox.demo.settings",
  name: "演示：设置（点开搜索）",
  order: 90,
  enabled: false, // 2026-10-14 误操作修复：演示规则默认关闭
  schemaVersion: 1,
  apps: [{ id: "com.android.settings" }],
  rules: [
    {
      id: "demo.settings@search",
      name: "设置：点开搜索",
      order: 0,
      matches: ['[text="搜索系统设置项"]'],
      action: "click",
      actionCd: 1200,
      actionMaximum: 1,
      note: "进设置首页自动点搜索栏，跳搜索页"
    }
  ]
}
